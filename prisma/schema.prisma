generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  memories      ConversationMemory[]
  relationships RelationshipContext[]
  resolutions   ResolutionMemory[]
  memorySettings MemorySettings?
  communicationPreferences CommunicationPreference[]
  feedbackEvents            FeedbackEvent[]
  personalizationSettings   PersonalizationSettings?
  workspaces                ConversationWorkspace[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Profile {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  textingProfile TextingProfile?
  conversations  Conversation[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("profiles")
}

model TextingProfile {
  id                   String   @id @default(cuid())
  profileId            String   @unique
  profile              Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  messageLength        String   @default("medium")
  capitalization       String   @default("mixed")
  punctuation          String   @default("moderate")
  emojiFrequency       String   @default("moderate")
  favoriteEmojis       String[]
  humor                String   @default("moderate")
  flirting             String   @default("moderate")
  slang                String   @default("moderate")
  abbreviations        String   @default("moderate")
  directness           String   @default("moderate")
  questionFrequency    String   @default("moderate")
  energy               String   @default("casual")
  sarcasm              String   @default("low")
  useOfLowercase       String   @default("sometimes")
  typicalOpenings      String[]
  typicalClosings      String[]
  oneLinerTendency     String   @default("moderate")
  conversationalEnergy String   @default("moderate")
  onboardingExamples   String[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("texting_profiles")
}

model Conversation {
  id            String             @id @default(cuid())
  profileId     String
  profile       Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform      String?
  goal          String?
  inputType     String             @default("text")
  stage         String?
  engagement    Float?
  flirting      Float?
  humor         Float?
  reciprocity   Float?
  conversationHealth Float?
  messages      ConversationMessage[]
  replies       GeneratedReply[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([profileId])
  @@index([profileId, createdAt(sort: Desc)])
  @@map("conversations")
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String
  text           String
  ordering       Int
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([conversationId, ordering])
  @@map("conversation_messages")
}

// ─── Conversation Workspace ────────────────────────────────────────────────────
//
// Workspace = persistent conversation context for the Analyze experience.
// Each workspace belongs to one user and contains participants + messages.
// Conversation state is derived at runtime, not stored permanently.
// ──────────────────────────────────────────────────────────────────────────────

model ConversationWorkspace {
  id             String                @id @default(cuid())
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String                @default("Untitled Conversation")
  platform       String?
  goal           String?
  language       String?
  version        Int                   @default(1)
  conversationVersion Int              @default(0)
  lastActiveAt   DateTime              @default(now())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  participants   WorkspaceParticipant[]
  messages       WorkspaceMessage[]

  @@index([userId])
  @@index([lastActiveAt])
  @@map("conversation_workspaces")
}

model WorkspaceParticipant {
  id             String                @id @default(cuid())
  workspaceId    String
  workspace      ConversationWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  displayName    String
  role           String                @default("participant")
  language       String?
  isUser         Boolean               @default(false)
  metadata       String?
  messages       WorkspaceMessage[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([workspaceId])
  @@map("workspace_participants")
}

model WorkspaceMessage {
  id             String                @id @default(cuid())
  workspaceId    String
  workspace      ConversationWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  participantId  String?
  participant    WorkspaceParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  sender         String                @default("unknown")
  text           String
  source         String                @default("user")
  sequence       Int
  metadata       String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, sequence])
  @@index([participantId])
  @@map("workspace_messages")
}

model GeneratedReply {
  id             String             @id @default(cuid())
  conversationId String
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  text           String
  strategy       String
  isBestMatch    Boolean            @default(false)
  selected       Boolean            @default(false)
  feedback       ReplyFeedback[]
  createdAt      DateTime           @default(now())

  @@index([conversationId])
  @@map("generated_replies")
}

model ReplyFeedback {
  id            String        @id @default(cuid())
  replyId       String
  reply         GeneratedReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  signal        String
  createdAt     DateTime      @default(now())

  @@map("reply_feedback")
}

// ─── Memory Models ─────────────────────────────────────────────────────────────
//
// Memory types:
// A. ConversationMemory - Short-term information about conversations
// B. RelationshipContext - High-level communication context
// C. ResolutionMemory - Outcomes from previous difficult conversations
//
// Privacy: All memory is user-controlled, scoped, and deletable.
// ──────────────────────────────────────────────────────────────────────────────

model ConversationMemory {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationshipId String?
  type           String    // MemoryType: conversation_topic, unresolved_issue, etc.
  content        String
  source         String    // MemorySource: explicit_user, user_confirmed, etc.
  confidence     Float     @default(0.5)
  isUserConfirmed Boolean @default(false)
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([relationshipId])
  @@index([type])
  @@index([createdAt])
  @@index([isActive])
  @@map("conversation_memories")
}

model RelationshipContext {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationshipType       String
  communicationPreferences String[]
  recurringIssues        String[]
  resolvedIssues         String[]
  activeIssues           String[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([userId, relationshipType])
  @@index([userId])
  @@map("relationship_contexts")
}

model ResolutionMemory {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationshipId         String?
  conflictCause          String
  resolution             String
  communicationPreference String?
  unresolvedFollowup     String?
  boundaryEstablished    String?
  confidence             Float     @default(0.5)
  expiresAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId])
  @@index([relationshipId])
  @@index([createdAt])
  @@map("resolution_memories")
}

model MemorySettings {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memoryEnabled Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("memory_settings")
}

// ─── Personalization Models ────────────────────────────────────────────────────
//
// Stores learned communication preferences from user feedback.
// - CommunicationPreference: A single learned preference (e.g., "formality": "casual")
// - FeedbackEvent: Tracks individual feedback signals for learning
//
// Privacy: All data is user-controlled, scoped, and deletable.
// Personalization NEVER fabricates traits — it only learns from explicit signals.
// ──────────────────────────────────────────────────────────────────────────────

model CommunicationPreference {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dimension     String   // Preference dimension: length, emoji, formality, tone, etc.
  value         String   // Learned value: "casual", "short", "none", etc.
  confidence    Float    @default(0.5)  // 0.0-1.0 confidence in this preference
  source        String   @default("implicit")  // "explicit" | "implicit"
  context       String?  // Optional context scope: "professional", "dating", etc.
  signalCount   Int      @default(1)   // Number of signals that contributed
  lastSignalAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, dimension, context])
  @@index([userId])
  @@index([dimension])
  @@map("communication_preferences")
}

model FeedbackEvent {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyId       String?  // Optional: link to GeneratedReply
  signal        String   // "thumbs_up" | "thumbs_down" | "copy" | "select" | "edit" | "regenerate" | "discard"
  context       String?  // Optional context: "professional", "dating", etc.
  strategy      String?  // Strategy of the reply that received feedback
  metadata      String?  // JSON string with additional signal data
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([signal])
  @@index([createdAt])
  @@map("feedback_events")
}

model PersonalizationSettings {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled       Boolean  @default(true)  // Master toggle for personalization
  learningEnabled Boolean @default(true) // Whether to learn from feedback
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("personalization_settings")
}
